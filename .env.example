# =====================================================================
# Variables d'environnement — copie ce fichier en `.env.local`
#   cp .env.example .env.local
# `.env.local` n'est jamais commité (cf. .gitignore).
# Sur Vercel : Project → Settings → Environment Variables.
# =====================================================================

# --- Base de données (Phase 0) ---------------------------------------
# URL PostgreSQL de Neon. Dans la console Neon : Connect → cocher
# "Connection pooling" → copier l'URL (hôte en `-pooler`).
# En local, une base PostgreSQL classique marche aussi :
#   postgresql://postgres:postgres@localhost:5432/staps
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification Better Auth (Phase 1) --------------------------
# Secret de signature des sessions : 32+ caractères aléatoires.
#   Générer : openssl rand -base64 32
# BETTER_AUTH_SECRET=""
# URL publique de l'app (sans slash final).
# BETTER_AUTH_URL="http://localhost:3000"
