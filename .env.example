# =====================================================================
# Variables d'environnement — copie ce fichier en `.env.local`
#   cp .env.example .env.local
# `.env.local` n'est jamais commité (cf. .gitignore).
# Sur Vercel : Project → Settings → Environment Variables.
# =====================================================================

# --- Base de données (Phase 0) ---------------------------------------
# URL PostgreSQL de Neon. Dans la console Neon : Connect → cocher
# "Connection pooling" → copier l'URL (hôte en `-pooler`).
# En local, une base PostgreSQL classique marche aussi :
#   postgresql://postgres:postgres@localhost:5432/staps
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification Better Auth -------------------------------------
# Secret de chiffrement/signature des sessions : 32+ caractères aléatoires.
# Obligatoire en production. Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de l'app, sans slash final (en prod : https://ton-app.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"

# Liste blanche d'emails autorisés à créer un compte, séparés par des virgules.
# Vide = inscriptions ouvertes à tous.
# ALLOWED_EMAILS="moi@exemple.fr"

# --- Emails (mot de passe oublié) --------------------------------------
# Clé API Resend (https://resend.com → API Keys). Sans clé, l'email n'est pas
# envoyé et le lien de réinitialisation s'affiche dans la console du serveur.
# RESEND_API_KEY=""
# Expéditeur. `onboarding@resend.dev` fonctionne sans domaine, mais n'écrit
# qu'à l'adresse de ton compte Resend (parfait pour un usage perso).
# EMAIL_FROM="STAPS <onboarding@resend.dev>"
